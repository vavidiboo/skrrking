# ─── 필수 시크릿 ──────────────────────────────────────────────────────────────
# Discord OAuth 클라이언트 ID (Discord Developer Portal에서 발급)
DISCORD_CLIENT_ID=

# Discord OAuth 클라이언트 시크릿 (Discord Developer Portal에서 발급)
DISCORD_CLIENT_SECRET=

# Activity identity 쿠키/토큰 서명용 HMAC 키 (32바이트 이상 랜덤 문자열)
# 예: python -c "import secrets; print(secrets.token_hex(32))"
ACTIVITY_IDENTITY_SIGNING_KEY=

# ─── Firebase 영속성 ──────────────────────────────────────────────────────────
# Firebase 서비스 계정 JSON 파일 경로 (없으면 메모리 전용 모드로 실행)
FIREBASE_CREDENTIALS_PATH=config/firebase.json

# ─── 네트워크 ─────────────────────────────────────────────────────────────────
ACTIVITY_HOST=0.0.0.0
ACTIVITY_PORT=8010

# 인증된 브라우저 origin 허용 목록 (쉼표 구분, 비워두면 CORS 비활성)
# 예: https://discord.com,https://canary.discord.com
ACTIVITY_CORS_ORIGINS=

# single_instance (현재 유일하게 지원하는 모드)
ACTIVITY_DEPLOYMENT_MODE=single_instance

# ─── 보안 / 쿠키 ─────────────────────────────────────────────────────────────
# auto | lax | strict | none
ACTIVITY_IDENTITY_COOKIE_SAMESITE=auto
# 0(개발) | 1(프로덕션 HTTPS 필수)
ACTIVITY_IDENTITY_COOKIE_SECURE=0

# Rate limiting (1=활성화, 0=비활성화)
ACTIVITY_ENABLE_RATE_LIMIT=1
ACTIVITY_RATE_LIMIT_WINDOW_SECONDS=60
ACTIVITY_RATE_LIMIT_DEFAULT_MAX_REQUESTS=600
ACTIVITY_RATE_LIMIT_STATE_MAX_REQUESTS=900
ACTIVITY_RATE_LIMIT_MUTATION_MAX_REQUESTS=240

# ─── 게임플레이 정책 ──────────────────────────────────────────────────────────
# 턴 시간 제한 (초)
ACTIVITY_TURN_LIMIT_SECONDS=20
# 턴 타임아웃 감지 주기 (초)
ACTIVITY_TIMEOUT_WATCH_INTERVAL_SECONDS=0.5
# long-poll 상태 폴링 주기 (초)
ACTIVITY_STATE_WAIT_POLL_INTERVAL_SECONDS=0.10
# 관전자 허용 여부 (0=비활성화, 1=활성화)
ACTIVITY_ALLOW_SPECTATORS=0
# 연결 끊김 후 grace 기간 (초)
ACTIVITY_DISCONNECT_GRACE_SECONDS=90
# 재접속 grace 기간 (초)
ACTIVITY_RECONNECT_GRACE_SECONDS=60
# 타임아웃 AFK 처리까지 허용 횟수
ACTIVITY_AFK_TIMEOUT_STREAK_LIMIT=3
# 트릭 결과 표시 유지 시간 (초)
ACTIVITY_TRICK_REVEAL_HOLD_SECONDS=5
# 혼자 남은 로비 만료 시간 (초)
ACTIVITY_SOLO_LOBBY_EXPIRY_SECONDS=300
# 빈 세션 정리 grace 기간 (초)
ACTIVITY_EMPTY_SESSION_GRACE_SECONDS=30
# Identity 토큰 유효 시간 (초, 기본 12시간)
ACTIVITY_IDENTITY_TOKEN_TTL_SECONDS=43200
# Identity 토큰 시간 오차 허용 범위 (초)
ACTIVITY_IDENTITY_TOKEN_SKEW_SECONDS=120

# ─── 개발 전용 ────────────────────────────────────────────────────────────────
# 개발 서버 자동 리로드 (1=활성화, 프로덕션에서는 반드시 0)
ACTIVITY_DEV_RELOAD=0

# ─── 로깅 ─────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
ACTIVITY_LOG_LEVEL=INFO
